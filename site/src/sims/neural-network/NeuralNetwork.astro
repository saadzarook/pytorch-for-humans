---
/**
 * <NeuralNetwork />: watch a small network learn a decision boundary, live.
 * Ported from reference/ml-sim-lab.html; maths checked against PyTorch.
 */
import SimShell from '../kit/SimShell.astro';
import RunControls from '../kit/RunControls.astro';
import LogPanel from '../kit/LogPanel.astro';
import cfg from './config.json';

interface Props {
  title?: string;
}
const { title = 'Watch a network learn' } = Astro.props;
---

<SimShell sim="neural-network" title={title} layout="two-column" keys={{ toggle: 'play / pause', next: '1 epoch' }}>
  <p slot="intro" class="sim-intro">
    A real network with 2 hidden layers trains here, using backprop and Adam written in plain
    JS. <b>Shading</b> is the network's guess for every spot on the map, and a stronger colour means
    more confident. The <b>solid line</b> is its decision boundary. <b>Red rings</b> mark points it
    currently gets wrong.
  </p>
  <div slot="stage">
    <canvas
      data-part="map"
      tabindex="0"
      role="img"
      aria-label="Two classes of points (amber and teal) with the network's decision regions and boundary line. Misclassified points are ringed in red."
    ></canvas>
  </div>
  <Fragment slot="side">
    <div class="sim-readout" data-part="readout"></div>
    <div>
      <div class="sim-eyebrow">loss per epoch</div>
      <div><canvas data-part="loss" aria-label="Training loss over epochs"></canvas></div>
    </div>
    <LogPanel />
  </Fragment>
  <RunControls stepLabel="1 epoch">
    <label class="pfh-field">
      <span>Data</span>
      <select data-part="dataset">
        <option value="circle">circle</option>
        <option value="xor">xor</option>
        <option value="spiral">spiral</option>
      </select>
    </label>
    <label class="pfh-field">
      <span>Neurons</span>
      <select data-part="hidden">
        {cfg.hiddenOptions.map((h) => <option selected={h === cfg.defaultHidden}>{h}</option>)}
      </select>
    </label>
    <label class="pfh-field">
      <span>Activation</span>
      <select data-part="activation">
        <option>tanh</option>
        <option>relu</option>
      </select>
    </label>
    <label class="pfh-field">
      <span>Learning rate: <span data-part="lr-out" class="pfh-mono"></span></span>
      <input data-part="lr" type="range" min="0" max="100" step="1" />
    </label>
  </RunControls>
</SimShell>
