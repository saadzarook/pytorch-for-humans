---
/**
 * <SimShell sim="optimizer-race" title="…" layout="two-column" options={…} keys={…}>
 *
 * The frame every course sim lives in (see docs/SIM_STANDARD.md):
 * - a lazily-mounted <pfh-sim> island: the sim's code loads only when it
 *   scrolls near the viewport (the framework-free version of client:visible)
 * - the narrator caption, an aria-live region
 * - the layout, so sims never hand-write grid CSS
 * - a keyboard hint, listing only the shortcuts this sim supports
 *
 * Layouts (all collapse to one column on phones):
 * - "stack"        default slot only, top to bottom
 * - "two-column"   slot="stage" (wide, left) | slot="side" (right), then the default slot
 * - "stage-chart"  the default slot, then slot="chart" | slot="side" side by side
 *
 * Mark elements with data-part="…" so mount() can find them. Inside the stage,
 * kit classes .sim-panels (equal panels) and .sim-trio (panel | narrow | panel)
 * cover multi-canvas stages.
 */
interface Props {
  /** Registry name in kit/island.ts. */
  sim: string;
  title: string;
  layout?: 'stack' | 'two-column' | 'stage-chart';
  /** JSON-serialisable options passed to mount(). */
  options?: unknown;
  /** Which keyboard shortcuts this sim supports. */
  keys?: { toggle?: string; next?: string; back?: string };
}
const { sim, title, layout = 'stack', options = {}, keys = { toggle: 'play / pause', next: 'step' } } = Astro.props;
---

<pfh-sim
  class="pfh-card sim"
  data-sim={sim}
  data-options={JSON.stringify(options)}
  tabindex="0"
  role="region"
  aria-label={`${title}: interactive simulation`}
>
  <div class="pfh-card-title">{title}</div>
  <slot name="intro" />
  <div class="sim-narr" data-part="narrator" role="status" aria-live="polite" aria-label="Narrator">
    <span class="ph">Loading</span>
    <b class="t">{title}</b>
    <p data-part="loading">Getting the simulation ready…</p>
  </div>
  {
    layout === 'two-column' && (
      <div class="sim-layout">
        <div class="sim-stack">
          <slot name="stage" />
        </div>
        <div class="sim-stack">
          <slot name="side" />
        </div>
      </div>
    )
  }
  <slot />
  {
    layout === 'stage-chart' && (
      <div class="sim-layout">
        <div class="sim-stack">
          <slot name="chart" />
        </div>
        <div class="sim-stack">
          <slot name="side" />
        </div>
      </div>
    )
  }
  <p class="sim-keys">
    Keys (click the sim first):
    {keys.toggle && <><kbd>Space</kbd> {keys.toggle}</>}
    {keys.next && <> · <kbd>→</kbd> {keys.next}</>}
    {keys.back && <> · <kbd>←</kbd> {keys.back}</>}
  </p>
</pfh-sim>

<script>
  import './island';
</script>
