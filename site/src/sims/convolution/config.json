{
  "$comment": "Read by math.ts and scripts/simref.py.",
  "imageRows": [
    "............",
    ".....##.....",
    "....#..#....",
    "...#....#...",
    "...#....#...",
    "..#......#..",
    "..########..",
    "..#......#..",
    ".#........#.",
    ".#........#.",
    "............",
    "............"
  ],
  "presets": {
    "vedge": [
      -1,
      0,
      1,
      -2,
      0,
      2,
      -1,
      0,
      1
    ],
    "hedge": [
      -1,
      -2,
      -1,
      0,
      0,
      0,
      1,
      2,
      1
    ],
    "outline": [
      -1,
      -1,
      -1,
      -1,
      8,
      -1,
      -1,
      -1,
      -1
    ],
    "blur": [
      0.1111111111111111,
      0.1111111111111111,
      0.1111111111111111,
      0.1111111111111111,
      0.1111111111111111,
      0.1111111111111111,
      0.1111111111111111,
      0.1111111111111111,
      0.1111111111111111
    ],
    "sharpen": [
      0,
      -1,
      0,
      -1,
      5,
      -1,
      0,
      -1,
      0
    ],
    "identity": [
      0,
      0,
      0,
      0,
      1,
      0,
      0,
      0,
      0
    ]
  },
  "beatsPerSecond": {
    "slow": 1.1111,
    "normal": 3.125,
    "fast": 14.2857
  },
  "claims": [
    {
      "id": "output-size",
      "says": "A 3×3 window fits in 12 − 3 + 1 = 10 positions across",
      "check": "outSize == imageSize - 3 + 1 and windows == outSize * outSize"
    },
    {
      "id": "vedge-ignores-crossbar",
      "says": "the middle of the crossbar stayed 0: this kernel ignores horizontal lines",
      "check": "all(v == 0 for v in vedgeCrossbarMiddle)"
    },
    {
      "id": "vedge-both-sides",
      "says": "amber on one side of each stroke and teal on the other",
      "check": "len(vedgeRowsWithBothSigns) > 0 and all(vedgeRowsWithBothSigns)"
    },
    {
      "id": "hedge-crossbar-edges",
      "says": "amber along its top edge and teal along its bottom edge",
      "check": "all(v > 0 for v in hedgeTopEdge) and all(v < 0 for v in hedgeBottomEdge)"
    },
    {
      "id": "hedge-sides-weak",
      "says": "while the slanted sides respond only weakly",
      "check": "hedgeOtherPeak < crossbarPeak"
    },
    {
      "id": "outline-flat-is-zero",
      "says": "In a flat area (all ink or all blank) the weights cancel out to 0.",
      "check": "abs(outlineWeightSum) < 1e-12"
    },
    {
      "id": "blur-ninths",
      "says": "each one counts 1/9",
      "check": "all(abs(w - 1 / 9) < 1e-15 for w in blurWeights)"
    },
    {
      "id": "identity-trims",
      "says": "the output is the input with its border trimmed off",
      "check": "identityTrimsBorder"
    }
  ]
}
