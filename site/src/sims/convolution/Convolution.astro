---
/**
 * <Convolution />: a 3×3 kernel sliding over a 12×12 "A", one window at a time.
 * Ported from reference/ml-sim-lab.html; outputs checked against F.conv2d.
 */
import SimShell from '../kit/SimShell.astro';
import RunControls from '../kit/RunControls.astro';
import facts from './facts.json';

interface Props {
  title?: string;
}
const { title = 'Convolution, one window at a time' } = Astro.props;
const n = facts.imageSize;
const o = facts.outSize;
---

<SimShell sim="convolution" title={title} keys={{ toggle: 'play / pause', next: 'step', back: 'back' }}>
  <p slot="intro" class="sim-intro">
    A 3×3 kernel slides over a {n}×{n} picture of the letter A. In <b>Slow</b> mode each window plays
    in three beats: place it, multiply, add up. The strip under the grids shows the real arithmetic.{' '}
    <b>Click any output pixel</b> to see how it was computed.
  </p>
  <div class="sim-trio">
    <div>
      <div class="cv-box"><canvas data-part="input" role="img" aria-label="Input image grid with the sliding kernel window"></canvas></div>
      <div class="cv-cap">input {n}×{n} (1 = ink, 0 = blank)</div>
    </div>
    <div class="cv-kcol">
      <label class="pfh-field">
        <span>Kernel</span>
        <select data-part="preset">
          <option value="vedge">vertical edges</option>
          <option value="hedge">horizontal edges</option>
          <option value="outline">outline</option>
          <option value="blur">blur</option>
          <option value="sharpen">sharpen</option>
          <option value="identity">identity</option>
          <option value="custom">custom</option>
        </select>
      </label>
      <div class="cv-kernel" data-part="kernel"></div>
      <div class="cv-kdesc" data-part="kdesc"></div>
    </div>
    <div>
      <div class="cv-box">
        <canvas
          data-part="output"
          tabindex="0"
          role="img"
          aria-label="Output feature map. Amber is positive, teal is negative. Click a pixel to inspect it."
        ></canvas>
      </div>
      <div class="cv-cap">
        output {o}×{o} · <span class="cv-amber">amber +</span> · <span class="cv-teal">teal −</span>
      </div>
    </div>
  </div>
  <div class="cv-explain" aria-label="Arithmetic for the current window">
    <div><div class="cv-mini" data-part="m-patch"></div><div class="cv-mcap">patch</div></div>
    <span class="cv-op">×</span>
    <div><div class="cv-mini" data-part="m-k"></div><div class="cv-mcap">kernel</div></div>
    <span class="cv-op">=</span>
    <div><div class="cv-mini" data-part="m-prod"></div><div class="cv-mcap">products</div></div>
    <span class="cv-op">→ Σ</span>
    <div><div class="cv-sum" data-part="sum">?</div><div class="cv-mcap">output pixel</div></div>
  </div>
  <RunControls resetLabel="↺ Restart">
    <button type="button" class="pfh-btn" data-part="back">◀&#xFE0E; Back</button>
    <button type="button" class="pfh-btn" data-part="jump">Next interesting window</button>
  </RunControls>
</SimShell>

<style>
  /* Canvases size to their box; capping the box keeps the grid cells square. */
  .cv-box {
    max-width: 280px;
    margin: 0 auto;
  }
  [data-part='output'] {
    cursor: pointer;
  }
  .cv-cap {
    font-family: var(--pfh-font-mono);
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
    text-align: center;
    margin-top: 0.4rem;
  }
  .cv-amber {
    color: var(--sim-amber);
    font-weight: 700;
  }
  .cv-teal {
    color: var(--sim-teal);
    font-weight: 700;
  }
  .cv-kcol {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    align-items: center;
    max-width: 14rem;
  }
  .cv-kernel {
    display: grid;
    grid-template-columns: repeat(3, 3.6rem);
    gap: 0.25rem;
  }
  .cv-kernel :global(input) {
    width: 3.6rem;
    min-height: 2.5rem;
    text-align: center;
    font-family: var(--pfh-font-mono);
    padding: 0.3rem 0.1rem;
    border: 1px solid var(--card-border);
    border-radius: 0.3rem;
    background: var(--sl-color-bg);
    color: var(--sl-color-white);
  }
  .cv-kdesc {
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-2);
    text-align: center;
  }
  .cv-explain {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.6rem 0.9rem;
    padding: 0.75rem;
    background: var(--sim-sunk);
    border-radius: 0.5rem;
  }
  .cv-mini {
    display: grid;
    grid-template-columns: repeat(3, 2.4rem);
    gap: 3px;
  }
  .cv-mini :global(span) {
    height: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--pfh-font-mono);
    font-size: 0.8rem;
    background: var(--sim-surface);
    color: var(--sim-text);
    border-radius: 3px;
    transition: background 0.25s, color 0.25s;
  }
  .cv-mini :global(span.lit) {
    background: var(--sim-text);
    color: var(--sim-surface);
  }
  .cv-mini :global(span.pos) {
    background: var(--sim-amber);
    color: #fff;
  }
  .cv-mini :global(span.neg) {
    background: var(--sim-teal);
    color: #fff;
  }
  .cv-mini :global(span.zero) {
    color: var(--sim-text-muted);
  }
  .cv-mini:global(.hidden) :global(span) {
    color: transparent;
    background: var(--sim-surface);
  }
  .cv-op {
    font-size: 1.4rem;
    color: var(--sl-color-gray-3);
  }
  .cv-mcap {
    font-family: var(--pfh-font-mono);
    font-size: 0.7rem;
    color: var(--sl-color-gray-3);
    text-align: center;
    margin-top: 0.25rem;
  }
  .cv-sum {
    font-family: var(--pfh-font-mono);
    font-size: 1.05rem;
    font-weight: 600;
    padding: 0.4rem 0.75rem;
    border-radius: 0.3rem;
    background: var(--sim-surface);
    min-width: 4rem;
    text-align: center;
  }
  @media (max-width: 50rem) {
    .cv-kcol {
      max-width: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cv-mini :global(span) {
      transition: none;
    }
  }
</style>
