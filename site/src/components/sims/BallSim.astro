---
/**
 * <BallSim />: gradient descent in 1D as a ball hopping down a curve.
 *
 * The reader picks a learning rate and a starting point, then plays / steps.
 * Shows the tangent (slope), the next hop, the update arithmetic and a live
 * loss-vs-step chart.
 *
 * Usage in MDX:
 *   <BallSim />                      // smooth bowl, can switch curves
 *   <BallSim curve="bumpy" />        // start on the bumpy curve
 */
import { curves } from './lib/curves';

interface Props {
  curve?: 'bowl' | 'bumpy';
  title?: string;
  /** Allow switching between the bowl and bumpy curves. */
  switchable?: boolean;
}

const { curve = 'bowl', title = 'Roll the ball downhill', switchable = true } = Astro.props;
const c = curves[curve];
---

<ball-sim class="pfh-card pfh-sim" data-curve={curve}>
  <div class="pfh-card-title">{title}</div>

  <div class="pfh-row presets" role="group" aria-label="Presets">
    {
      c.presets.map((p, i) => (
        <button type="button" class="pfh-btn" data-preset={i} aria-pressed="false">
          {p.label}
        </button>
      ))
    }
  </div>

  <div class="stage">
    <canvas
      class="curve-canvas"
      role="img"
      aria-label="A loss curve with a ball on it. The ball's position and the loss are described in the text below the chart."
    ></canvas>
  </div>

  <p class="readout pfh-mono" aria-hidden="true"></p>
  <p class="equation pfh-mono"></p>
  <p class="status" role="status" aria-live="polite"></p>

  <div class="pfh-row buttons">
    <button type="button" class="pfh-btn pfh-btn--primary" data-action="play">▶&#xFE0E; Play</button>
    <button type="button" class="pfh-btn" data-action="step">Step +1</button>
    <button type="button" class="pfh-btn" data-action="reset">↺ Reset</button>
  </div>

  <div class="controls">
    <label class="pfh-field">
      <span>Learning rate (step size): <output class="lr-out"></output></span>
      <input class="lr" type="range" min="0" max="1000" step="1" />
    </label>
    <label class="pfh-field">
      <span>Starting point w₀: <output class="start-out"></output></span>
      <input class="start" type="range" step="0.1" />
    </label>
    {
      switchable && (
        <label class="pfh-field">
          <span>Loss curve</span>
          <select class="curve-select">
            <option value="bowl" selected={curve === 'bowl'}>
              Smooth bowl
            </option>
            <option value="bumpy" selected={curve === 'bumpy'}>
              Bumpy hills (local minima)
            </option>
          </select>
        </label>
      )
    }
  </div>

  <figure class="chart">
    <canvas class="chart-canvas" aria-hidden="true"></canvas>
    <figcaption>Loss after each step (hover or tap for exact values)</figcaption>
  </figure>
</ball-sim>

<style>
  .stage {
    position: relative;
    margin-block: 0.75rem 0.25rem;
    border-radius: 0.5rem;
    overflow: hidden;
  }
  canvas {
    display: block;
    touch-action: pan-y;
  }
  .readout,
  .equation {
    font-size: var(--sl-text-sm);
    margin: 0.25rem 0 0;
    overflow-wrap: anywhere;
  }
  .equation {
    color: var(--sl-color-gray-2);
  }
  .status {
    min-height: 1.5em;
    margin: 0.5rem 0;
    font-size: var(--sl-text-sm);
  }
  .status:empty {
    margin: 0;
  }
  .controls {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 0.75rem 1.25rem;
    margin-top: 0.75rem;
  }
  .buttons {
    margin-top: 0.5rem;
  }
  .chart {
    margin: 1rem 0 0;
  }
  .chart figcaption {
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
    margin-top: 0.25rem;
  }
</style>

<script>
  import { curves, type Curve1D } from './lib/curves';
  import { fitCanvas, onResize, scale, dot, arrowHead, type Surface } from './lib/canvas';
  import { readColors, onThemeChange } from './lib/theme';
  import { Player } from './lib/player';
  import { LossChart } from './lib/lossChart';
  import { fmt, logSlider, niceLr } from './lib/format';

  const MAX_STEPS = 300;
  const LR = logSlider(0.001, 1.5);

  class BallSim extends HTMLElement {
    private curve!: Curve1D;
    private lr = 0.3;
    private start = -2;
    private ws: number[] = [];
    private done = false;
    private surface!: Surface;
    private player!: Player;
    private chart!: LossChart;
    private canvas!: HTMLCanvasElement;
    private q = <T extends Element>(sel: string) => this.querySelector(sel) as T;

    connectedCallback() {
      this.curve = curves[(this.dataset.curve as 'bowl' | 'bumpy') ?? 'bowl'];
      this.canvas = this.q<HTMLCanvasElement>('.curve-canvas');
      this.chart = new LossChart(this.q<HTMLCanvasElement>('.chart-canvas'));
      this.surface = fitCanvas(this.canvas, 1.7, 360);

      this.player = new Player({
        stepsPerSecond: 8,
        step: () => this.step(),
        render: (t) => this.render(t),
        onPlayingChange: (playing) => {
          const btn = this.q<HTMLButtonElement>('[data-action="play"]');
          btn.textContent = playing ? '⏸︎ Pause' : '▶︎ Play';
          if (!playing) this.announce();
        },
      });

      this.wireControls();
      this.applyCurve(this.curve, this.curve.defaultLr, this.curve.defaultStart);

      onResize(this.q('.stage'), () => {
        this.surface = fitCanvas(this.canvas, 1.7, 360);
        this.player.redraw();
      });
      onThemeChange(() => {
        this.player.redraw();
        this.chart.draw();
      });
    }

    // ---------- state ----------

    private get w() {
      return this.ws[this.ws.length - 1];
    }

    private reset() {
      this.player.pause();
      this.ws = [this.start];
      this.done = false;
      this.q('.status').textContent = '';
      this.updateTexts();
      this.chart.setValues([this.curve.f(this.start)]);
      this.player.redraw();
    }

    private step(): boolean {
      if (this.done) return false;
      const w = this.w;
      const slope = this.curve.df(w);
      const next = w - this.lr * slope;
      this.ws.push(next);
      this.chart.setValues(this.ws.map(this.curve.f));
      this.updateTexts();

      const status = this.q('.status');
      const loss = this.curve.f(next);
      if (!Number.isFinite(loss) || Math.abs(next) > 1e6) {
        this.done = true;
        status.textContent =
          '💥 Loss exploded. 🐶☕🔥 "This is fine." (It is not fine.) Every hop overshoots the valley by more than the last. Try a smaller learning rate.';
        return false;
      }
      if (Math.abs(next - w) < 5e-4 && Math.abs(this.curve.df(next)) < 5e-3) {
        this.done = true;
        const steps = this.ws.length - 1;
        const atGlobal = Math.abs(next - this.curve.globalMin) < 0.05;
        status.textContent = atGlobal
          ? `🎯 Settled at the bottom (w = ${fmt(next, 2)}) after ${steps} steps.`
          : `🦋 Settled at w = ${fmt(next, 2)} after ${steps} steps. "Is this the global minimum?" Nope: it's a local minimum. There's a deeper valley at w ≈ ${fmt(this.curve.globalMin, 2)}.`;
        return false;
      }
      if (this.ws.length - 1 >= MAX_STEPS) {
        this.done = true;
        status.textContent = `⏱️ Stopped after ${MAX_STEPS} steps without settling. Too slow? Too bouncy? Try another learning rate.`;
        return false;
      }
      return true;
    }

    // ---------- UI ----------

    private wireControls() {
      const lr = this.q<HTMLInputElement>('.lr');
      const start = this.q<HTMLInputElement>('.start');

      lr.addEventListener('input', () => {
        this.lr = niceLr(LR.toValue(Number(lr.value)));
        this.clearPresetPressed();
        this.syncOutputs();
        this.reset();
      });
      start.addEventListener('input', () => {
        this.start = Number(start.value);
        this.clearPresetPressed();
        this.syncOutputs();
        this.reset();
      });
      this.querySelector<HTMLSelectElement>('.curve-select')?.addEventListener('change', (e) => {
        const id = (e.target as HTMLSelectElement).value as 'bowl' | 'bumpy';
        const c = curves[id];
        this.applyCurve(c, c.defaultLr, c.defaultStart);
        this.renderPresets();
      });

      this.addEventListener('click', (e) => {
        const target = (e.target as HTMLElement).closest('button');
        if (!target || !this.contains(target)) return;
        const action = target.dataset.action;
        if (action === 'play') {
          if (this.done) this.reset();
          this.player.toggle();
        } else if (action === 'step') {
          if (this.done) this.reset();
          this.player.stepOnce();
          this.announce();
        } else if (action === 'reset') {
          this.reset();
        } else if (target.dataset.preset !== undefined) {
          const p = this.curve.presets[Number(target.dataset.preset)];
          this.applyCurve(this.curve, p.lr, p.start);
          this.q<HTMLElement>('.presets')
            .querySelectorAll('button')
            .forEach((b) => b.setAttribute('aria-pressed', String(b === target)));
          this.q('.status').textContent = `${p.label}: ${p.hint} Press Play.`;
        }
      });
    }

    private renderPresets() {
      const box = this.q<HTMLElement>('.presets');
      box.replaceChildren(
        ...this.curve.presets.map((p, i) => {
          const b = document.createElement('button');
          b.type = 'button';
          b.className = 'pfh-btn';
          b.dataset.preset = String(i);
          b.setAttribute('aria-pressed', 'false');
          b.textContent = p.label;
          return b;
        }),
      );
    }

    private clearPresetPressed() {
      this.q<HTMLElement>('.presets')
        .querySelectorAll('button')
        .forEach((b) => b.setAttribute('aria-pressed', 'false'));
    }

    private applyCurve(c: Curve1D, lr: number, start: number) {
      this.curve = c;
      this.lr = lr;
      this.start = start;
      const s = this.q<HTMLInputElement>('.start');
      s.min = String(c.domain[0] + 0.1);
      s.max = String(c.domain[1] - 0.1);
      s.value = String(start);
      this.q<HTMLInputElement>('.lr').value = String(LR.toPos(lr));
      this.syncOutputs();
      this.reset();
    }

    private syncOutputs() {
      this.q('.lr-out').textContent = String(this.lr);
      this.q('.start-out').textContent = fmt(this.start, 1);
    }

    private updateTexts() {
      const w = this.w;
      const slope = this.curve.df(w);
      const next = w - this.lr * slope;
      const steps = this.ws.length - 1;
      this.q('.readout').textContent =
        `step ${steps} · w = ${fmt(w)} · slope = ${fmt(slope)} · loss = ${fmt(this.curve.f(w))}`;
      const s = slope < 0 ? `(${fmt(slope)})` : fmt(slope);
      this.q('.equation').textContent = Number.isFinite(next)
        ? `next w = w − lr × slope = ${fmt(w)} − ${this.lr} × ${s} = ${fmt(next)}`
        : '';
    }

    /** Screen-reader summary, announced after a manual step or when playback stops. */
    private announce() {
      const status = this.q('.status');
      if (this.done) return; // a convergence / explosion message is already there
      const w = this.w;
      status.textContent = `Step ${this.ws.length - 1}: w is ${fmt(w, 2)}, slope ${fmt(this.curve.df(w), 2)}, loss ${fmt(this.curve.f(w), 3)}.`;
    }

    // ---------- drawing ----------

    private render(t: number) {
      const colors = readColors();
      const { ctx, width, height } = this.surface;
      const c = this.curve;
      const pad = { l: 36, r: 14, t: 14, b: 30 };
      const x = scale(c.domain[0], c.domain[1], pad.l, width - pad.r);
      const y = scale(c.range[0], c.range[1], height - pad.b, pad.t);

      ctx.clearRect(0, 0, width, height);
      ctx.fillStyle = colors.surface;
      ctx.fillRect(0, 0, width, height);

      // Axes (recessive).
      ctx.strokeStyle = colors.grid;
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(pad.l, height - pad.b + 0.5);
      ctx.lineTo(width - pad.r, height - pad.b + 0.5);
      ctx.moveTo(pad.l + 0.5, pad.t);
      ctx.lineTo(pad.l + 0.5, height - pad.b);
      ctx.stroke();
      ctx.fillStyle = colors.textMuted;
      ctx.font = `12px ${colors.fontSans}`;
      ctx.textAlign = 'right';
      ctx.fillText('w →', width - pad.r, height - 8);
      ctx.textAlign = 'left';
      ctx.fillText('loss', 4, pad.t + 4);
      ctx.font = `11px ${colors.fontMono}`;
      ctx.textAlign = 'center';
      const [d0, d1] = c.domain;
      for (let v = Math.ceil(d0); v <= Math.floor(d1); v++) {
        if (v % 2 !== 0 && width < 480) continue;
        ctx.fillText(String(v).replace('-', '−'), x(v), height - pad.b + 14);
      }

      // The loss curve (2px).
      ctx.strokeStyle = colors.curve;
      ctx.lineWidth = 2;
      ctx.beginPath();
      const N = 240;
      for (let i = 0; i <= N; i++) {
        const w = d0 + ((d1 - d0) * i) / N;
        const py = y(Math.min(c.f(w), c.range[1] * 1.2));
        if (i === 0) ctx.moveTo(x(w), py);
        else ctx.lineTo(x(w), py);
      }
      ctx.stroke();

      // Trail of previous positions.
      const trail = this.ws.slice(Math.max(0, this.ws.length - 30), -1);
      trail.forEach((w, i) => {
        if (!this.visible(w)) return;
        ctx.globalAlpha = 0.15 + (0.45 * (i + 1)) / trail.length;
        ctx.beginPath();
        ctx.arc(x(w), y(c.f(w)), 3, 0, Math.PI * 2);
        ctx.fillStyle = colors.mark;
        ctx.fill();
      });
      ctx.globalAlpha = 1;

      // Where is the ball right now? Tween as a little hop from the previous position.
      const cur = this.w;
      const prev = this.ws.length > 1 ? this.ws[this.ws.length - 2] : cur;
      const wx = prev + (cur - prev) * t;
      const ly = c.f(prev) + (c.f(cur) - c.f(prev)) * t;
      const hop = Math.min(36, Math.abs(x(cur) - x(prev)) * 0.25) * Math.sin(Math.PI * t);
      const bx = x(wx);
      const by = y(ly) - hop;

      const r = 9;
      if (this.visible(cur) && c.f(cur) <= c.range[1] * 1.2) {
        // Tangent line at the current point, once the hop has landed.
        if (t >= 1) {
          const slope = c.df(cur);
          const kx = (x(1) - x(0));
          const ky = (y(1) - y(0));
          const dx = 1;
          const dy = (slope * ky) / kx;
          const len = Math.hypot(dx, dy);
          const L = Math.min(90, width * 0.18);
          ctx.strokeStyle = colors.tangent;
          ctx.lineWidth = 1.5;
          ctx.setLineDash([6, 4]);
          ctx.beginPath();
          ctx.moveTo(bx - (dx / len) * L, y(c.f(cur)) - (dy / len) * L);
          ctx.lineTo(bx + (dx / len) * L, y(c.f(cur)) + (dy / len) * L);
          ctx.stroke();
          ctx.setLineDash([]);

          // Ghost of the next hop + arrow along the floor.
          const next = cur - this.lr * slope;
          if (!this.done && Number.isFinite(next)) {
            const nx = x(Math.max(d0, Math.min(d1, next)));
            const floor = height - pad.b - 8;
            if (Math.abs(nx - bx) > 4) {
              ctx.strokeStyle = colors.mark;
              ctx.lineWidth = 2;
              ctx.beginPath();
              ctx.moveTo(bx, floor);
              ctx.lineTo(nx, floor);
              ctx.stroke();
              arrowHead(ctx, nx, floor, nx > bx ? 0 : Math.PI, 7, colors.mark);
            }
            if (this.visible(next) && c.f(next) <= c.range[1]) {
              ctx.strokeStyle = colors.mark;
              ctx.lineWidth = 1.5;
              ctx.setLineDash([3, 3]);
              ctx.beginPath();
              ctx.arc(x(next), y(c.f(next)) - r, r, 0, Math.PI * 2);
              ctx.stroke();
              ctx.setLineDash([]);
            }
          }
        }
        dot(ctx, bx, by - r, r, colors.mark, colors.markRing);
      } else {
        // Ball has left the visible world: point at where it went.
        const right = cur > (d0 + d1) / 2;
        const ax = right ? width - pad.r - 10 : pad.l + 10;
        arrowHead(ctx, ax, pad.t + 20, right ? -Math.PI / 4 : (-3 * Math.PI) / 4, 10, colors.bad);
        ctx.fillStyle = colors.bad;
        ctx.font = `bold 12px ${colors.fontSans}`;
        ctx.textAlign = right ? 'right' : 'left';
        ctx.fillText(`ball flew off to w = ${fmt(cur, 1)}`, right ? ax - 14 : ax + 14, pad.t + 40);
      }
    }

    private visible(w: number) {
      return Number.isFinite(w) && w >= this.curve.domain[0] && w <= this.curve.domain[1];
    }
  }

  customElements.define('ball-sim', BallSim);
</script>
