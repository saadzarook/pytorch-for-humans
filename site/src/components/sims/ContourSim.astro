---
/**
 * <ContourSim />: fitting a line y = w·x + b with gradient descent.
 *
 * Left: the data and the current line.
 * Right: the loss landscape over (w, b) seen from above (a contour map),
 * with the path gradient descent takes. Click/tap the map, or use the
 * sliders, to choose where to start.
 *
 * Everything lesson-specific comes in as props, normally straight from the
 * lesson's data.json (whose claims facts.py checks):
 *
 *   <ContourSim data={data.delivery} config={data.contour} />
 */
import type { Dataset } from './lib/curves';

export interface ContourConfig {
  start: { w: number; b: number };
  maxSteps: number;
  /** Visible ranges: w and b on the map, x and y on the data plot. */
  view: { w: number[]; b: number[]; x: number[]; y: number[] };
  xLabel: string;
  yLabel: string;
  /** Plain-words reading of the line, with {w} and {b} placeholders. */
  describe: string;
  presets: { id: string; label: string; lr: number }[];
}

interface Props {
  data: Dataset;
  config: ContourConfig;
  title?: string;
}
const { data, config, title = 'Fit the line, walk the bowl' } = Astro.props;
const { presets, view } = config;
const dataLabel = `Scatter plot of ${config.yLabel} versus ${config.xLabel.replace(/ ?→$/, '')} with the current fitted line.`;
---

<contour-sim class="pfh-card pfh-sim" data-config={JSON.stringify({ x: data.x, y: data.y, ...config })}>
  <div class="pfh-card-title">{title}</div>

  <div class="pfh-row presets" role="group" aria-label="Learning-rate presets">
    {
      presets.map((p, i) => (
        <button type="button" class="pfh-btn" data-preset={i} aria-pressed="false">
          {p.label}
        </button>
      ))
    }
  </div>

  <div class="panels">
    <figure>
      <div class="cv"><canvas
        class="data-canvas"
        role="img"
        aria-label={dataLabel}
      ></canvas></div>
      <figcaption>The data and the current line</figcaption>
    </figure>
    <figure>
      <div class="cv"><canvas
        class="contour-canvas"
        role="img"
        aria-label="Contour map of the loss for every slope w and intercept b. Faint colour means low loss, strong blue means high loss. Gradient descent's path is drawn on top. Click to choose a starting point."
      ></canvas></div>
      <figcaption>Loss landscape from above: faint = low loss, strong blue = high, × = best line. Tap to pick a start.</figcaption>
    </figure>
  </div>

  <p class="readout pfh-mono" aria-hidden="true"></p>
  <p class="plain"></p>
  <p class="status" role="status" aria-live="polite"></p>

  <div class="pfh-row buttons">
    <button type="button" class="pfh-btn pfh-btn--primary" data-action="play">▶&#xFE0E; Play</button>
    <button type="button" class="pfh-btn" data-action="step">Step +1</button>
    <button type="button" class="pfh-btn" data-action="reset">↺ Reset</button>
  </div>

  <div class="controls">
    <label class="pfh-field">
      <span>Learning rate: <output class="lr-out"></output></span>
      <input class="lr" type="range" min="0" max="1000" step="1" />
    </label>
    <label class="pfh-field">
      <span>Start slope w₀: <output class="w0-out"></output></span>
      <input class="w0" type="range" min={view.w[0]} max={view.w[1]} step="0.1" />
    </label>
    <label class="pfh-field">
      <span>Start intercept b₀: <output class="b0-out"></output></span>
      <input class="b0" type="range" min={view.b[0]} max={view.b[1]} step="0.1" />
    </label>
  </div>

  <figure class="chart">
    <canvas class="chart-canvas" aria-hidden="true"></canvas>
    <figcaption>Loss after each step (hover or tap for exact values)</figcaption>
  </figure>
</contour-sim>

<style>
  .panels {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1rem;
    margin-top: 0.75rem;
  }
  figure {
    margin: 0;
    min-width: 0;
  }
  .cv {
    border-radius: 0.5rem;
    overflow: hidden;
  }
  canvas {
    display: block;
    touch-action: pan-y;
  }
  .contour-canvas {
    cursor: crosshair;
  }
  figcaption {
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
    margin-top: 0.25rem;
  }
  .readout,
  .plain {
    font-size: var(--sl-text-sm);
    margin: 0.5rem 0 0;
    overflow-wrap: anywhere;
  }
  .status {
    min-height: 1.5em;
    margin: 0.5rem 0;
    font-size: var(--sl-text-sm);
  }
  .status:empty {
    margin: 0;
  }
  .controls {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: 0.75rem 1.25rem;
    margin-top: 0.75rem;
  }
  .buttons {
    margin-top: 0.5rem;
  }
  .chart {
    margin-top: 1rem;
  }
</style>

<script>
  import { lineFit } from './lib/curves';
  import type { ContourConfig } from './ContourSim.astro';
  import { fitCanvas, onResize, scale, dot, type Surface } from './lib/canvas';
  import { readColors, onThemeChange, hexToRgb, type SimColors } from './lib/theme';
  import { Player } from './lib/player';
  import { LossChart } from './lib/lossChart';
  import { fmt, logSlider, niceLr } from './lib/format';

  const LR = logSlider(0.001, 0.25);

  type Config = ContourConfig & { x: number[]; y: number[] };

  /** About `count` round-numbered ticks between lo and hi. */
  function ticks(lo: number, hi: number, count = 5): number[] {
    const raw = (hi - lo) / count;
    const mag = 10 ** Math.floor(Math.log10(raw));
    const step = [1, 2, 5, 10].map((m) => m * mag).find((st) => st >= raw) ?? raw;
    const out: number[] = [];
    for (let v = Math.ceil(lo / step) * step; v <= hi + 1e-9; v += step) out.push(Math.round(v * 1e6) / 1e6);
    return out;
  }

  class ContourSim extends HTMLElement {
    private lr = 0.1;
    private w0 = 0;
    private b0 = 0;
    private path: [number, number][] = [];
    private done = false;
    private player!: Player;
    private chart!: LossChart;
    private dataCanvas!: HTMLCanvasElement;
    private mapCanvas!: HTMLCanvasElement;
    private dataSurf!: Surface;
    private mapSurf!: Surface;
    private heat: HTMLCanvasElement | null = null;
    private cfg!: Config;
    private fit!: ReturnType<typeof lineFit>;
    private q = <T extends Element>(sel: string) => this.querySelector(sel) as T;

    connectedCallback() {
      this.cfg = JSON.parse(this.dataset.config ?? '{}');
      this.fit = lineFit(this.cfg);
      this.dataCanvas = this.q('.data-canvas');
      this.mapCanvas = this.q('.contour-canvas');
      this.chart = new LossChart(this.q('.chart-canvas'));
      this.resize();

      this.player = new Player({
        stepsPerSecond: 20,
        step: () => this.step(),
        render: (t) => this.render(t),
        onPlayingChange: (playing) => {
          this.q('[data-action="play"]').textContent = playing ? '⏸︎ Pause' : '▶︎ Play';
          if (!playing) this.announce();
        },
      });

      this.wire();
      // Start on the "good" preset if there is one, else the first.
      const initial = this.cfg.presets.find((p) => p.id === 'good') ?? this.cfg.presets[0];
      this.setLr(initial.lr);
      this.setStart(this.cfg.start.w, this.cfg.start.b);

      onResize(this.q('.panels'), () => {
        this.resize();
        this.player.redraw();
      });
      onThemeChange(() => {
        this.heat = null;
        this.player.redraw();
        this.chart.draw();
      });
    }

    private resize() {
      this.dataSurf = fitCanvas(this.dataCanvas, 1.25, 340);
      this.mapSurf = fitCanvas(this.mapCanvas, 1.25, 340);
      this.heat = null;
    }

    // ---------- state ----------

    private get cur() {
      return this.path[this.path.length - 1];
    }

    private reset() {
      this.player.pause();
      this.path = [[this.w0, this.b0]];
      this.done = false;
      this.q('.status').textContent = '';
      this.chart.setValues([this.fit.mse(this.w0, this.b0)]);
      this.updateTexts();
      this.player.redraw();
    }

    private step(): boolean {
      if (this.done) return false;
      const [w, b] = this.cur;
      const [gw, gb] = this.fit.grad(w, b);
      const nw = w - this.lr * gw;
      const nb = b - this.lr * gb;
      this.path.push([nw, nb]);
      this.chart.setValues(this.path.map(([pw, pb]) => this.fit.mse(pw, pb)));
      this.updateTexts();

      const status = this.q('.status');
      const loss = this.fit.mse(nw, nb);
      if (!Number.isFinite(loss) || loss > 1e8) {
        this.done = true;
        status.textContent =
          '💥 Loss exploded. 🐶☕🔥 "This is fine." Each step overshoots the valley a bit more than the last, along the steep direction of the bowl. Lower the learning rate.';
        return false;
      }
      if (Math.hypot(nw - w, nb - b) < 1e-4) {
        this.done = true;
        status.textContent = `🎯 Converged after ${this.path.length - 1} steps: w ≈ ${fmt(nw, 2)}, b ≈ ${fmt(nb, 2)}. That's the best line through the data.`;
        return false;
      }
      if (this.path.length - 1 >= this.cfg.maxSteps) {
        this.done = true;
        status.textContent = `⏱️ Stopped after ${this.cfg.maxSteps} steps. Still getting there… a bigger learning rate would be faster.`;
        return false;
      }
      return true;
    }

    // ---------- UI ----------

    private wire() {
      const lr = this.q<HTMLInputElement>('.lr');
      lr.addEventListener('input', () => {
        this.setLr(niceLr(LR.toValue(Number(lr.value))), false);
        this.clearPressed();
        this.reset();
      });
      const w0 = this.q<HTMLInputElement>('.w0');
      const b0 = this.q<HTMLInputElement>('.b0');
      const onStart = () => this.setStart(Number(w0.value), Number(b0.value));
      w0.addEventListener('input', onStart);
      b0.addEventListener('input', onStart);

      this.mapCanvas.addEventListener('click', (e) => {
        const rect = this.mapCanvas.getBoundingClientRect();
        const { xw, yb } = this.mapScales();
        const w = Math.round(xw.invert(e.clientX - rect.left) * 10) / 10;
        const b = Math.round(yb.invert(e.clientY - rect.top) * 10) / 10;
        this.setStart(clamp(w, this.cfg.view.w[0], this.cfg.view.w[1]), clamp(b, this.cfg.view.b[0], this.cfg.view.b[1]));
      });

      this.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest('button');
        if (!btn || !this.contains(btn)) return;
        const action = btn.dataset.action;
        if (action === 'play') {
          if (this.done) this.reset();
          this.player.toggle();
        } else if (action === 'step') {
          if (this.done) this.reset();
          this.player.stepOnce();
          this.announce();
        } else if (action === 'reset') {
          this.reset();
        } else if (btn.dataset.preset !== undefined) {
          const p = this.cfg.presets[Number(btn.dataset.preset)];
          this.setLr(p.lr);
          this.q<HTMLElement>('.presets')
            .querySelectorAll('button')
            .forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
          this.reset();
          this.q('.status').textContent = `${p.label} (learning rate ${p.lr}). Press Play.`;
        }
      });
    }

    private clearPressed() {
      this.q<HTMLElement>('.presets')
        .querySelectorAll('button')
        .forEach((b) => b.setAttribute('aria-pressed', 'false'));
    }

    private setLr(lr: number, moveSlider = true) {
      this.lr = lr;
      if (moveSlider) this.q<HTMLInputElement>('.lr').value = String(LR.toPos(lr));
      this.q('.lr-out').textContent = String(lr);
    }

    private setStart(w: number, b: number) {
      this.w0 = w;
      this.b0 = b;
      this.q<HTMLInputElement>('.w0').value = String(w);
      this.q<HTMLInputElement>('.b0').value = String(b);
      this.q('.w0-out').textContent = fmt(w, 1);
      this.q('.b0-out').textContent = fmt(b, 1);
      this.reset();
    }

    private updateTexts() {
      const [w, b] = this.cur;
      this.q('.readout').textContent =
        `step ${this.path.length - 1} · w = ${fmt(w)} · b = ${fmt(b)} · loss = ${fmt(this.fit.mse(w, b))}`;
      this.q('.plain').textContent =
        Number.isFinite(w) && Math.abs(w) < 1e4 && Math.abs(b) < 1e4
          ? `In plain words, the line says: ${this.cfg.describe.replace('{w}', fmt(w, 1)).replace('{b}', fmt(b, 1))}.`
          : 'In plain words, the line says: nonsense. 🫠';
    }

    private announce() {
      if (this.done) return;
      const [w, b] = this.cur;
      this.q('.status').textContent = `Step ${this.path.length - 1}: w ${fmt(w, 2)}, b ${fmt(b, 2)}, loss ${fmt(this.fit.mse(w, b), 3)}.`;
    }

    // ---------- drawing ----------

    private render(t: number) {
      const colors = readColors();
      const n = this.path.length;
      const [w1, b1] = this.cur;
      const [w0, b0] = n > 1 ? this.path[n - 2] : this.cur;
      const w = w0 + (w1 - w0) * t;
      const b = b0 + (b1 - b0) * t;
      this.drawData(colors, w, b);
      this.drawMap(colors, w, b);
    }

    private drawData(colors: SimColors, w: number, b: number) {
      const { ctx, width, height } = this.dataSurf;
      const pad = { l: 40, r: 12, t: 12, b: 34 };
      const { view, xLabel, yLabel } = this.cfg;
      const x = scale(view.x[0], view.x[1], pad.l, width - pad.r);
      const y = scale(view.y[0], view.y[1], height - pad.b, pad.t);
      ctx.clearRect(0, 0, width, height);
      ctx.fillStyle = colors.surface;
      ctx.fillRect(0, 0, width, height);

      ctx.strokeStyle = colors.grid;
      ctx.lineWidth = 1;
      ctx.fillStyle = colors.textMuted;
      ctx.font = `11px ${colors.fontMono}`;
      for (const v of ticks(view.y[0], view.y[1], 3)) {
        ctx.beginPath();
        ctx.moveTo(pad.l, Math.round(y(v)) + 0.5);
        ctx.lineTo(width - pad.r, Math.round(y(v)) + 0.5);
        ctx.stroke();
        ctx.textAlign = 'right';
        ctx.fillText(String(v), pad.l - 6, y(v) + 4);
      }
      ctx.textAlign = 'center';
      for (const v of ticks(view.x[0], view.x[1], 4)) ctx.fillText(String(v), x(v), height - pad.b + 14);
      ctx.font = `12px ${colors.fontSans}`;
      ctx.fillText(xLabel, (pad.l + width - pad.r) / 2, height - 4);
      ctx.save();
      ctx.translate(11, (pad.t + height - pad.b) / 2);
      ctx.rotate(-Math.PI / 2);
      ctx.fillText(yLabel, 0, 0);
      ctx.restore();

      // Current line, clipped to the plot.
      ctx.save();
      ctx.beginPath();
      ctx.rect(pad.l, pad.t, width - pad.l - pad.r, height - pad.t - pad.b);
      ctx.clip();
      if (Number.isFinite(w) && Number.isFinite(b)) {
        ctx.strokeStyle = colors.mark;
        ctx.lineWidth = 2.5;
        ctx.beginPath();
        ctx.moveTo(x(view.x[0]), y(w * view.x[0] + b));
        ctx.lineTo(x(view.x[1]), y(w * view.x[1] + b));
        ctx.stroke();
        // Residuals: how wrong the line is for each point.
        ctx.strokeStyle = colors.mark;
        ctx.globalAlpha = 0.35;
        ctx.lineWidth = 1;
        this.cfg.x.forEach((xi, i) => {
          ctx.beginPath();
          ctx.moveTo(x(xi), y(this.cfg.y[i]));
          ctx.lineTo(x(xi), y(w * xi + b));
          ctx.stroke();
        });
        ctx.globalAlpha = 1;
      }
      ctx.restore();

      this.cfg.x.forEach((xi, i) => dot(ctx, x(xi), y(this.cfg.y[i]), 4.5, colors.point, colors.surface));
    }

    private mapScales() {
      const { width, height } = this.mapSurf;
      const pad = { l: 40, r: 12, t: 12, b: 34 };
      return {
        pad,
        xw: scale(this.cfg.view.w[0], this.cfg.view.w[1], pad.l, width - pad.r),
        yb: scale(this.cfg.view.b[0], this.cfg.view.b[1], height - pad.b, pad.t),
      };
    }

    /** Pre-render the contour bands once per size/theme into an offscreen canvas. */
    private buildHeat(colors: SimColors) {
      const { width, height } = this.mapSurf;
      const { pad, xw, yb } = this.mapScales();
      const dpr = Math.min(window.devicePixelRatio || 1, 3);
      const pw = Math.round((width - pad.l - pad.r) * dpr);
      const ph = Math.round((height - pad.t - pad.b) * dpr);
      const off = document.createElement('canvas');
      off.width = pw;
      off.height = ph;
      const octx = off.getContext('2d')!;
      const img = octx.createImageData(pw, ph);
      const lo = hexToRgb(colors.heatLow);
      const hi = hexToRgb(colors.heatHigh);
      const minL = this.fit.mse(this.fit.best.w, this.fit.best.b);
      const BANDS = 14;
      const band = new Int16Array(pw * ph);
      // Bands on a log scale: the bowl is very steep, so equal-loss bands would
      // all bunch up at the edges.
      // Normalise by the highest loss at any corner of the visible map.
      const { w: vw, b: vb } = this.cfg.view;
      const corners = [vw[0], vw[1]].flatMap((cw) => [vb[0], vb[1]].map((cb) => this.fit.mse(cw, cb)));
      const maxLog = Math.log(Math.max(...corners) - minL + 1);
      for (let j = 0; j < ph; j++) {
        const bv = yb.invert(pad.t + j / dpr);
        for (let i = 0; i < pw; i++) {
          const wv = xw.invert(pad.l + i / dpr);
          const v = Math.log(this.fit.mse(wv, bv) - minL + 1) / maxLog;
          band[j * pw + i] = Math.min(BANDS - 1, Math.floor(Math.sqrt(Math.max(v, 0)) * BANDS));
        }
      }
      for (let j = 0; j < ph; j++) {
        for (let i = 0; i < pw; i++) {
          const k = j * pw + i;
          const f = band[k] / (BANDS - 1);
          const edge =
            (i + 1 < pw && band[k + 1] !== band[k]) || (j + 1 < ph && band[k + pw] !== band[k]);
          const mix = edge ? Math.min(1, f + 0.18) : f;
          img.data[k * 4] = lo[0] + (hi[0] - lo[0]) * mix;
          img.data[k * 4 + 1] = lo[1] + (hi[1] - lo[1]) * mix;
          img.data[k * 4 + 2] = lo[2] + (hi[2] - lo[2]) * mix;
          img.data[k * 4 + 3] = 255;
        }
      }
      octx.putImageData(img, 0, 0);
      this.heat = off;
    }

    private drawMap(colors: SimColors, w: number, b: number) {
      const { ctx, width, height } = this.mapSurf;
      const { pad, xw, yb } = this.mapScales();
      if (!this.heat) this.buildHeat(colors);
      ctx.clearRect(0, 0, width, height);
      ctx.fillStyle = colors.surface;
      ctx.fillRect(0, 0, width, height);
      ctx.drawImage(this.heat!, pad.l, pad.t, width - pad.l - pad.r, height - pad.t - pad.b);

      ctx.fillStyle = colors.textMuted;
      ctx.font = `11px ${colors.fontMono}`;
      ctx.textAlign = 'center';
      const { w: vw, b: vb } = this.cfg.view;
      for (const v of ticks(vw[0], vw[1], 5)) ctx.fillText(String(v).replace('-', '−'), xw(v), height - pad.b + 14);
      ctx.textAlign = 'right';
      for (const v of ticks(vb[0], vb[1], 4)) ctx.fillText(String(v).replace('-', '−'), pad.l - 6, yb(v) + 4);
      ctx.font = `12px ${colors.fontSans}`;
      ctx.textAlign = 'center';
      ctx.fillText('slope w →', (pad.l + width - pad.r) / 2, height - 4);
      ctx.save();
      ctx.translate(11, (pad.t + height - pad.b) / 2);
      ctx.rotate(-Math.PI / 2);
      ctx.fillText('intercept b', 0, 0);
      ctx.restore();

      // Best-fit marker: a small ×.
      ctx.strokeStyle = colors.text;
      ctx.lineWidth = 1.5;
      const bx = xw(this.fit.best.w);
      const by = yb(this.fit.best.b);
      ctx.beginPath();
      ctx.moveTo(bx - 4, by - 4);
      ctx.lineTo(bx + 4, by + 4);
      ctx.moveTo(bx + 4, by - 4);
      ctx.lineTo(bx - 4, by + 4);
      ctx.stroke();

      // Path so far (clipped), then the current point.
      ctx.save();
      ctx.beginPath();
      ctx.rect(pad.l, pad.t, width - pad.l - pad.r, height - pad.t - pad.b);
      ctx.clip();
      ctx.strokeStyle = colors.mark;
      ctx.lineWidth = 2;
      ctx.lineJoin = 'round';
      ctx.beginPath();
      const pts = this.path.slice(0, -1).concat([[w, b]]);
      pts.forEach(([pw, pb], i) => {
        const px = xw(clamp(pw, -1e4, 1e4));
        const py = yb(clamp(pb, -1e4, 1e4));
        if (i === 0) ctx.moveTo(px, py);
        else ctx.lineTo(px, py);
      });
      ctx.stroke();
      ctx.restore();

      const inside = w >= vw[0] && w <= vw[1] && b >= vb[0] && b <= vb[1];
      if (inside) {
        dot(ctx, xw(w), yb(b), 6, colors.mark, colors.markRing);
      } else {
        ctx.fillStyle = colors.bad;
        ctx.font = `bold 12px ${colors.fontSans}`;
        ctx.textAlign = 'center';
        ctx.fillText('💥 point left the map', (pad.l + width - pad.r) / 2, pad.t + 18);
      }
    }
  }

  function clamp(v: number, lo: number, hi: number) {
    return Math.max(lo, Math.min(hi, v));
  }

  customElements.define('contour-sim', ContourSim);
</script>
