---
/**
 * <NotebookLinks meta={kernelMeta} source="course/foundations/01-gradient-descent/notebook.py" />
 *
 * The "use the real tool" launchpad: Open in Kaggle, download the .ipynb,
 * view the source, and a collapsible "run it on your own machine" guide.
 *
 * `meta` is the lesson's kernel-metadata.json (import it in the MDX), so the
 * Kaggle slug lives in exactly one place.
 */
import fs from 'node:fs';
import path from 'node:path';
import { KAGGLE_USERNAME, KAGGLE_USERNAME_PLACEHOLDER, REPO_URL } from '~/config';

interface Props {
  meta: { id: string; code_file: string; title: string };
  /** Repo-relative path to the jupytext source, for the "view source" link. */
  source: string;
}

const { meta, source } = Astro.props;
const kaggleUrl = KAGGLE_USERNAME
  ? `https://www.kaggle.com/code/${meta.id.replace(KAGGLE_USERNAME_PLACEHOLDER, KAGGLE_USERNAME)}`
  : null;

// The .ipynb is generated by scripts/build_notebooks.py into public/notebooks.
// Only link to it if it was built (CI always builds it before the site).
const nbFile = meta.code_file;
const nbBuilt = fs.existsSync(path.join(process.cwd(), 'public', 'notebooks', nbFile));
const nbHref = `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}notebooks/${nbFile}`;
const sourceUrl = REPO_URL ? `${REPO_URL.replace(/\/$/, '')}/blob/main/${source}` : null;
---

<div class="pfh-card nb-links">
  <div class="pfh-card-title">🚀 Run the real PyTorch version</div>
  <p>
    The full notebook tells this same story with real PyTorch, interactive Plotly charts and
    animations. It runs top to bottom on Kaggle's free CPU, with no setup and no files to upload.
  </p>
  <div class="pfh-row">
    {
      kaggleUrl ? (
        <a class="pfh-btn pfh-btn--primary" href={kaggleUrl} target="_blank" rel="noopener">
          Open in Kaggle ↗
        </a>
      ) : (
        <span class="pfh-btn" aria-disabled="true" title="The course author hasn't published this notebook to Kaggle yet.">
          Kaggle link coming soon
        </span>
      )
    }
    {
      nbBuilt && (
        <a class="pfh-btn" href={nbHref} download>
          ⬇ Download .ipynb
        </a>
      )
    }
    {
      sourceUrl && (
        <a class="pfh-btn" href={sourceUrl} target="_blank" rel="noopener">
          View source ↗
        </a>
      )
    }
  </div>
  {
    kaggleUrl && (
      <p class="small">
        On Kaggle, click <strong>Copy &amp; Edit</strong> to get your own runnable copy. The
        published page is read-only.
      </p>
    )
  }
  {
    !kaggleUrl && nbBuilt && (
      <p class="small">
        Until the Kaggle link is live: download the .ipynb, then on Kaggle choose{' '}
        <strong>Create → New Notebook → File → Import Notebook</strong>.
      </p>
    )
  }

  <details>
    <summary>💻 Run it on your own machine instead</summary>
    <ol>
      <li>Install Python 3.12 or newer from <a href="https://www.python.org/downloads/">python.org</a>.</li>
      <li>
        Make a virtual environment (a private box for this course's packages) and switch it on:
        <pre><code>python -m venv .venv
# Windows:
.venv\Scripts\activate
# macOS / Linux:
source .venv/bin/activate</code></pre>
      </li>
      <li>
        Install PyTorch. The CPU build is all this lesson needs (and it's a much smaller download):
        <pre><code>pip install torch==2.14.1 --index-url https://download.pytorch.org/whl/cpu</code></pre>
        Got an NVIDIA GPU and want to use it later? Get the exact command from the selector at{' '}
        <a href="https://pytorch.org/get-started/locally/">pytorch.org/get-started</a>.
      </li>
      <li>
        Install the rest and open the notebook:
        <pre><code>pip install numpy matplotlib plotly jupyterlab
jupyter lab {nbFile}</code></pre>
      </li>
    </ol>
  </details>
</div>

<style>
  .nb-links p {
    margin-bottom: 0.75rem;
  }
  .small {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
    margin-top: 0.75rem;
  }
  a.pfh-btn {
    text-decoration: none;
  }
  details {
    margin-top: 1rem;
    border-top: 1px solid var(--card-border);
    padding-top: 0.75rem;
  }
  summary {
    cursor: pointer;
    font-weight: 600;
    min-height: 2rem;
  }
  ol {
    margin-top: 0.75rem;
    padding-left: 1.25rem;
  }
  li + li {
    margin-top: 0.75rem;
  }
  pre {
    margin-top: 0.4rem;
    padding: 0.6rem 0.75rem;
    border-radius: 0.4rem;
    background: var(--sl-color-black);
    overflow-x: auto;
    font-size: 0.8rem;
  }
</style>
