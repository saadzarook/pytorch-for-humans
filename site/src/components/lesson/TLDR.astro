---
/** <TLDR>…a short bullet list…</TLDR>: the end-of-lesson summary card. */
---

<section class="pfh-card tldr" aria-label="TL;DR">
  <div class="pfh-card-title">📌 TL;DR</div>
  <slot />
</section>

<style>
  .tldr {
    border: 2px solid var(--sl-color-accent);
  }
  .tldr :global(ul) {
    padding-left: 1.25rem;
  }
  .tldr :global(li + li) {
    margin-top: 0.35rem;
  }
</style>
